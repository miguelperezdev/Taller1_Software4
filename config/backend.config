# Nodo 2 - Servidor E-Commerce (Backend Core)
#
# En varios equipos, -h debe ser la IP de este equipo: las pasarelas usan
# esta dirección para enviar el resultado de cada pago al receptor.
Backend.Endpoints=tcp -h 127.0.0.1 -p 10002

# Nodo 4
Persistencia.Proxy=Persistencia:tcp -h 127.0.0.1 -p 10000

# Nodo 3: una entrada por medio de pago (Pagos.<medio>.Proxy).
# Para habilitar un medio nuevo basta con agregar su línea aquí.
Pagos.stripe.Proxy=EstrategiaStripe:tcp -h 127.0.0.1 -p 10001
Pagos.pse.Proxy=EstrategiaPSE:tcp -h 127.0.0.1 -p 10001
Pagos.cripto.Proxy=EstrategiaCripto:tcp -h 127.0.0.1 -p 10001
Pagos.billetera.Proxy=EstrategiaBilleteraDigital:tcp -h 127.0.0.1 -p 10001

# Tiempo máximo para el acuse de una pasarela y circuit breaker por medio
Pagos.TimeoutMs=2000
Pagos.FallosParaAbrirCircuito=3
Pagos.EsperaCircuitoMs=15000

Ice.Default.InvocationTimeout=3000
Ice.ThreadPool.Server.Size=8
Ice.ThreadPool.Server.SizeMax=64
