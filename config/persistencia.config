# Nodo 4 - Servidor Base de Datos Transaccional
Persistencia.Endpoints=tcp -h 127.0.0.1 -p 10000

# Por defecto: H2 en memoria con sintaxis de PostgreSQL (no requiere instalar nada).
BaseDatos.Url=jdbc:h2:mem:apexstore_tx;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
BaseDatos.Usuario=sa
BaseDatos.Clave=

# Con un PostgreSQL real:
# BaseDatos.Url=jdbc:postgresql://localhost:5432/apexstore_tx
# BaseDatos.Usuario=apexstore
# BaseDatos.Clave=apexstore

Ice.ThreadPool.Server.Size=8
